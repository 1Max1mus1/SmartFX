APP_NAME=SmartFX API
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8010
APP_RELOAD=false
APP_ENDPOINT_PREFIX=/api
APP_ALLOWED_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]
APP_SECRET_KEY=replace-with-a-long-random-secret
APP_ACCESS_TOKEN_EXPIRE_MINUTES=1440

DB_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/postgres
DB_ECHO=false

RATE_PROVIDER=exchange-rate-api
RATE_EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6
RATE_EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
RATE_CACHE_TTL_SECONDS=300

AI_PROVIDER=moonshot
AI_MODEL=moonshot-v1-8k
AI_API_KEY=your-moonshot-api-key
AI_BASE_URL=https://api.moonshot.cn/v1
